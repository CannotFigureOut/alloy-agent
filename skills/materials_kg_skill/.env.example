# 复制本文件为 .env 并填写真实值： cp .env.example .env

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
# 使用非默认数据库时填写，例如 neo4j
NEO4J_DATABASE=

# ---------- LLM（任意 OpenAI 兼容接口） ----------
# OpenAI 示例：
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   EMBEDDING_MODEL=text-embedding-3-small
# DeepSeek 示例（核心抽取/问答不依赖 embedding，可留空 EMBEDDING_MODEL）：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# 若 embedding 服务与 LLM 不同源，单独指定：
EMBEDDING_BASE_URL=
LLM_TEMPERATURE=0

# ---------- 可选：方案 A 的 pdf2md-agent-skill ----------
# 克隆 https://github.com/taotaoboom/pdf2md-agent-skill 后，填入其目录绝对路径。
# 留空或脚本不存在时自动回退到 PyMuPDF 方案 B。
PDF2MD_SKILL_DIR=

# ---------- PDF 解析后端 ----------
# auto             = 依次尝试 pdf2md-agent-skill → pymupdf4llm → 纯 PyMuPDF 增强（推荐）
# pdf2md_skill     = 只用方案 A（外部 Skill，需 PDF2MD_SKILL_DIR）
# pymupdf4llm      = 只用 PyMuPDF 官方方案 B（需 pip install pymupdf4llm）
# pymupdf_enhanced = 只用纯 PyMuPDF 方案 C（无需额外依赖）
PDF_BACKEND=auto
# 表格检测策略：lines / lines_strict / text / explicit
# ⚠ 学术论文常见「三线表 / booktabs」没有竖线，lines_strict 会漏检；
#   若发现表格仍是压扁的纯文本，改成 text（用文字坐标推断虚拟列边界）。
PDF_TABLE_STRATEGY=lines_strict
# 导出 PDF 中的图片并在 Markdown 里生成相对引用
PDF_WRITE_IMAGES=true
PDF_IMAGE_DPI=150

# ---------- 路径与运行参数 ----------
PAPER_LIBRARY_DIR=./paper_library
CHUNK_SIZE=1800
CHUNK_OVERLAP=200
TOP_K=5
