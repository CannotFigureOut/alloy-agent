# 首次启动由 run.sh / run.ps1 复制为 .env；已有 .env 不会被覆盖。
# 推荐启动后在前端「模型设置」中配置、测试并保存模型。
# 界面保存后新任务立即生效；手动编辑 .env 后需重启服务。

# OpenAI 兼容模型：同时用于自然语言理解、候选工作流规划和阶段分析。
AGENT_MODE=openai
# API 基础地址，通常包含 /v1；程序会追加 /chat/completions。
# 示例：https://api.your-provider.com/v1
MODEL_BASE_URL=
# 仅保存在服务端，不向前端回传。不要将真实密钥提交到版本控制。
MODEL_API_KEY=
# 填写服务商提供的模型标识。
MODEL_NAME=
# 上述三项未完整配置前，不能进行大模型语义规划；不会回退到固定流程。

# SQLite 数据库路径；启动脚本从项目根目录运行。
DATABASE_PATH=data/alloy.db
# 阶段执行超时（秒）；OpenAI 兼容接口单次 HTTP 请求最多等待 30 秒。
MODEL_TIMEOUT_SECONDS=90

# 应用默认监听 127.0.0.1，无身份认证，适用于可信本地环境。
